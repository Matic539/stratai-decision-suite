# ============================================================
# StratAI Decision Suite: variables de entorno
# Copia este archivo como .env y completa tus valores.
# El archivo .env NUNCA se sube al repositorio.
# ============================================================

# Modo de persistencia: csv | mongodb | postgres
DB_MODE=csv

# Servidor (127.0.0.1 = solo accesible desde tu equipo)
HOST=127.0.0.1
PORT=3000

# ---- Instancia 2: MongoDB Atlas (tu propio clúster) ----
# Usuario con readWrite solo sobre stratai_db y solo tu IP en Network Access.
# Carga y verificación: npm run cargar:mongodb
MONGO_URI=mongodb+srv://<usuario>:<password>@<tu-cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=stratai_db

# ---- Instancia 3: PostgreSQL ----
# Usuario stratai_app: lo crea sql/esquema_postgresql.sql con permisos mínimos y su
# contraseña se define con \password stratai_app (ver docs/guia-paso-a-paso-fase5.md).
# Carga y verificación: npm run cargar:postgres
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=stratai_app
PGPASSWORD=
PGDATABASE=stratai_db

# ---- Comité IA ----
# Proveedor: openrouter | local  (sin llave se usa siempre el dictamen local)
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Uno o más modelos separados por coma; se prueban en orden.
# openrouter/free es el router gratuito de OpenRouter (respaldo).
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free,openrouter/free
# Consultas al Comité por minuto (los modelos gratuitos permiten 20/min y 50/día)
IA_LIMITE_POR_MINUTO=10
# Tiempo máximo de espera por intento (ms). Los modelos que razonan pueden tardar más de 30 s.
IA_TIMEOUT_MS=90000
