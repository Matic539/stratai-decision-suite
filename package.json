{
  "name": "stratai-decision-suite",
  "version": "1.0.0",
  "private": true,
  "description": "Suite web de decisiones estratégicas: motor de reglas de negocio determinista + Comité IA, con persistencia CSV, MongoDB Atlas y PostgreSQL.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "diagnostico:ia": "node scripts/diagnostico-ia.js",
    "cargar:mongodb": "node scripts/cargar-mongodb.js",
    "cargar:postgres": "node scripts/cargar-postgres.js",
    "comparar": "node scripts/comparar-instancias.js"
  },
  "dependencies": {
    "chart.js": "^4.6.1",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "mongodb": "^7.8.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "mingo": "^7.2.7"
  }
}
